# HTTP server
PORT=8787
HOST=127.0.0.1

# SQLite file. Use an absolute path outside the repo in production.
ORBIT_DB_PATH=./data/orbit.db
ORBIT_LOG_LEVEL=info

# Task attachments: keep the directory on the same disk as backups.
ORBIT_FILES_DIR=./data/files
ORBIT_MAX_UPLOAD_MB=50
ORBIT_TASK_FILE_LIMIT=20
ORBIT_PROJECT_QUOTA_MB=2048

# Default timezone for cron automations when omitted.
ORBIT_TIMEZONE=Asia/Shanghai

# Set to 1 in tests or when another process owns the scheduler.
ORBIT_DISABLE_SCHEDULER=0

# DeepSeek API credential (keep the real value in .env, never commit it).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# WeKnora agent runtime. Orbit's Actor / Agent Job / MCP interfaces stay unchanged.
WEKNORA_API_URL=http://127.0.0.1:8088/api/v1
WEKNORA_API_KEY=
WEKNORA_AGENT_ID=
# Optional; defaults to WEKNORA_API_URL without /api/v1. Used for citation links.
WEKNORA_UI_URL=http://127.0.0.1:8088
